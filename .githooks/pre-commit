#!/bin/sh
# Three gates, all refusable with: git commit --no-verify

# 1. Refuse commits made directly on main; work on a branch and open a pull request.
# stderr is discarded: symbolic-ref fails on a detached HEAD, an ordinary state during a rebase.
git symbolic-ref --short HEAD 2>/dev/null | grep -qx main && {
    echo "pre-commit: refusing to commit on main." >&2
    echo "Create a branch first:  git checkout -b <name>" >&2
    echo "Deliberate exception:   git commit --no-verify" >&2
    exit 1
}

cd "$(git rev-parse --show-toplevel)" || exit 1

# 2. Scan the staged change for secrets. A missing gitleaks fails the commit: a gate that
# passes whenever the tool is absent is not a gate.
command -v gitleaks >/dev/null 2>&1 || {
    echo "pre-commit: gitleaks is not installed, so the staged change cannot be scanned." >&2
    echo "Install it:             brew install gitleaks" >&2
    echo "Deliberate exception:   git commit --no-verify" >&2
    exit 1
}
# --exit-code 2 tells a found secret apart from a scan that could not run; both are 1 otherwise.
gitleaks git --staged --redact --no-banner -v --exit-code 2
case $? in
    0) ;;
    2)
        echo "pre-commit: gitleaks found a secret in the staged change (shown redacted above)." >&2
        echo "Unstage it and keep the value out of the repository." >&2
        exit 1
        ;;
    *)
        echo "pre-commit: gitleaks could not scan the staged change (see the error above)." >&2
        exit 1
        ;;
esac

# 3. Refuse unformatted Swift. It checks the working tree, not the index: a file formatted but
# not re-staged passes here and is caught by the same check in CI.
scripts/swift-format.sh lint || {
    echo "pre-commit: formatting check failed (see above)." >&2
    echo "Fix it:                 scripts/swift-format.sh format" >&2
    echo "Deliberate exception:   git commit --no-verify" >&2
    exit 1
}
